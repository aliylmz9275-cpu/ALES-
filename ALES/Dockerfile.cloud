# ALES Cloud - cok asamali build
# 1. asama: React/Vite frontend'i derle (cikti ALES/dist/ klasorune duser,
#    vite.config.js'deki outDir ayari geregi)
# 2. asama: Python backend + derlenmis frontend'i TEK image'da birlestir
#
# Railway/Render'da "Root Directory" olarak bu ALES/ klasorunu, "Dockerfile
# Path" olarak da Dockerfile.cloud'u gostermen gerekiyor (asagidaki
# CLOUD_DEPLOY.md dosyasinda adim adim anlatildi).

# ─── ASAMA 1: FRONTEND BUILD ───────────────────────────────────────
FROM node:20-slim AS frontend-build
WORKDIR /build
COPY frontend/package*.json ./frontend/
RUN cd frontend && npm install
COPY frontend/ ./frontend/
# vite.config.js: outDir = path.resolve(__dirname, '../dist') -> /build/dist
RUN cd frontend && npm run build

# ─── ASAMA 2: PYTHON BACKEND + STATIK FRONTEND ────────────────────
FROM python:3.11-slim AS runtime
WORKDIR /app

# main_cloud.py'nin reuse ettigi backend/ modulleri (multi_agent.py,
# conversations.py, config_manager.py, personas.py) icin gereken minimum
# dosyalar. Selenium/Playwright/pyautogui gibi PC-bagimli, cloud'da
# kullanilmayacak agir bagimliliklari BILEREK KOPYALAMIYORUZ.
COPY railway/requirements_cloud.txt ./railway/requirements_cloud.txt
RUN pip install --no-cache-dir -r railway/requirements_cloud.txt

COPY backend/config_manager.py ./backend/config_manager.py
COPY backend/multi_agent.py ./backend/multi_agent.py
COPY backend/conversations.py ./backend/conversations.py
COPY railway/main_cloud.py ./railway/main_cloud.py

# Asama 1'de derlenen frontend (/build/dist) -> /app/dist
# (main_cloud.py DIST_DIR = .../main_cloud.py'nin bulundugu klasorun
# BIR UST DIZINI / "dist" olarak hesapliyor, yani /app/dist olmali)
COPY --from=frontend-build /build/dist ./dist

ENV PORT=8000
EXPOSE 8000

CMD ["python", "railway/main_cloud.py"]
