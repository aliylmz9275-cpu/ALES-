# ===================================================================
# DİĞER SAĞLAYICILAR — isimler config_manager._ENV_KEY_MAP ile birebir
# ===================================================================
# Başındaki '#' işaretini kaldırıp değeri yaz. İsimleri DEĞİŞTİRME:
# config_manager.get_key() tam olarak bu adlara bakar, farklı yazılan
# bir ad sessizce görmezden gelinir (hata vermez, anahtar yok sayılır).
#
# ÖNCELİK: config.json'daki değer KAZANIR. Buradaki değer yalnızca
# config.json'da o alan BOŞ ise kullanılır. Ayrıca bu dosya, oturumda
# elle "set XXX=..." ile tanımlanmış bir değişkeni EZMEZ.
#
# CEREBRAS_API_KEY=
# GEMINI_API_KEY=          # 'AIza' ile başlamalı — OAuth jetonu (AQ./ya29.) reddedilir
# OPENROUTER_API_KEY=
# SAMBANOVA_API_KEY=
# ELEVENLABS_API_KEY=      # opsiyonel: yoksa edge-tts kullanılır

# ── OPSİYONEL DAVRANIŞ ANAHTARLARI ─────────────────────────────────
# ALES_CUA_SANDBOX=true    # bilgisayar kontrolü eylemlerini SİMÜLE et (ekrana dokunmaz)
# ALES_CUA_MODEL_URL=      # yerel bir EvoCUA/InAgent ucu varsa adresi

# ⚠ GÜVENLİK: bu dosya düz metin anahtar taşıyor. Yukarıdaki GROQ ve
# NVIDIA anahtarları bu dosyada göründüğü için yanmış sayılmalı —
# sağlayıcı panelinden İPTAL edip yenisini üretmek gerekir. Yeni
# anahtarları buraya yazmak sorun değil, ama bu dosyayı kimseyle
# paylaşma ve arşive/ekran görüntüsüne alma.

