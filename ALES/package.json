{
  "name": "ales",
  "version": "3.0.0",
  "description": "ALES - Advanced Logic Execution System",
  "main": "electron-main.js",
  "scripts": {
    "dev": "vite --config frontend/vite.config.js",
    "build:frontend": "vite build --config frontend/vite.config.js",
    "build:backend": "python -m PyInstaller backend/ales-backend.spec --noconfirm --distpath backend-dist --workpath backend/build",
    "build:exe": "electron-builder",
    "start": "electron ."
  },
  "build": {
    "appId": "com.ales.app",
    "productName": "ALES",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "ALES.exe",
      "requestExecutionLevel": "user",
      "unpackDirName": "ALES"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "ALES"
    },
    "files": [
      "dist/**/*",
      "electron-main.js",
      "preload.js",
      "assets/**/*",
      "!node_modules/**",
      "!backend/**",
      "!frontend/**",
      "!backend-dist/**"
    ],
    "extraResources": [
      {
        "from": "backend-dist/ales-backend.exe",
        "to": "ales-backend.exe",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "dist",
        "to": "dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "backend/skills",
        "to": "skills",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "backend/plugins",
        "to": "plugins",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "vite": "^5.4.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0"
  }
}
